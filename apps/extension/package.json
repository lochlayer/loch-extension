{
  "name": "@loch/extension",
  "version": "0.1.0",
  "private": true,
  "description": "The Loch browser extension (Manifest V3): a shielded balance inside the Solana wallet you already use.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && vitest run --config vitest.e2e.config.ts",
    "shots": "node scripts/shots.mjs",
    "connect-page": "tsx e2e/serve.ts"
  },
  "dependencies": {
    "@loch/design": "workspace:*",
    "@loch/rpc-client": "workspace:*",
    "@loch/scanner-core": "workspace:*",
    "@loch/sdk": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@scure/base": "^1.2.6",
    "@solana/web3.js": "^1.98.0",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
