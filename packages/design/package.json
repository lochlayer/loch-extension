{
  "name": "@loch/design",
  "version": "0.1.0",
  "private": true,
  "description": "The Loch design system: tokens, self-hosted fonts, base styles, components, icons, the mark and chart helpers shared by the website and the browser extension. Framework-free. No network requests.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./base.css": "./base.css",
    "./components.css": "./components.css",
    "./all.css": "./all.css",
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "default": "./dist/charts/index.js"
    },
    "./numerals": {
      "types": "./dist/numerals.d.ts",
      "default": "./dist/numerals.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./icons/sprite.svg": "./icons/sprite.svg",
    "./icons/*.svg": "./icons/*.svg",
    "./mark/*": "./mark/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "tokens.css",
    "fonts.css",
    "base.css",
    "components.css",
    "all.css",
    "fonts",
    "icons",
    "mark",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-icons.mjs && tsc -p tsconfig.build.json",
    "prepare": "(node scripts/build-icons.mjs && tsc -p tsconfig.build.json) || echo \"@loch/design: build skipped, run pnpm build\"",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run",
    "contrast": "node scripts/contrast.mjs",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "fonts:check": "node scripts/sync-fonts.mjs --check",
    "fonts:tabular": "python3 scripts/build-tabular.py",
    "mark": "node scripts/draw-mark.mjs && node scripts/build-mark.mjs",
    "guide": "node scripts/build-guide.mjs",
    "shots": "node scripts/shots.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/libre-franklin": "5.2.8",
    "@fontsource/old-standard-tt": "5.3.0",
    "@loch/scanner-core": "workspace:*",
    "@types/node": "^22.0.0",
    "playwright": "^1.55.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
